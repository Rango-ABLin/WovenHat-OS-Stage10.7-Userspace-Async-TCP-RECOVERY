+    let Ok(class) = crate::async_op::class_current(handle) else {
+        return SYSCALL_ERROR;
+    };
+    if !authorize_async_class(class) {
+        return SYSCALL_ERROR;
+    }
+    match crate::async_op::peek_current(handle) {
