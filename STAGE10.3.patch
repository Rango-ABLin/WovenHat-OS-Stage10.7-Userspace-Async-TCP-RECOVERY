+    pub const fn from_raw(raw: u64) -> Option<Self> {
+        if raw & 0x0000_ffff_0000 != 0 {
+            return None;
+        }
+        let generation = (raw >> 32) as u32;
+        let slot = (raw & 0xffff) as u16;
+        if generation == 0 || slot as usize >= MAX_ASYNC_OPERATIONS {
+            return None;
+        }
+        Some(Self { slot, generation })
+    }
+}
