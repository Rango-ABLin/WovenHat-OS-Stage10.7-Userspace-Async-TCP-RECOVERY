+    const fn directory(path: &[u8]) -> Self {
+        let mut node = Self::empty();
+        let mut index = 0;
+        while index < path.len() {
+            node.path[index] = path[index];
+            index += 1;
+        }
+        node.path_length = path.len();
+        node.kind = NodeKind::Directory;
+        node.writable = true;
+        node.occupied = true;
+        node
+    }
