+        nodes[4] = Node::directory(b"/bin");
+        nodes[5] = Node::with_data(b"/etc/motd", b"Welcome to WovenHat OS.\n", false);
+        nodes[6] = Node::with_data(b"/etc/version", b"WovenHat kernel 0.8.0 Multicore Foundation\n", false);
