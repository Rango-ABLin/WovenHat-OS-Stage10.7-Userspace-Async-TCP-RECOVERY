+        if self.nodes.iter().any(|node| node.matches(path)) {
+            return Err(Error::AlreadyExists);
+        }
+        let parent = parent_path(path).ok_or(Error::InvalidPath)?;
+        if !self
+            .nodes
+            .iter()
+            .any(|n| n.matches(parent) && n.kind == NodeKind::Directory)
